#!/bin/sh
# kermach (t381, имя с t396): обёртка для sh — Git Bash (в нём команды запускает Claude на Windows) и Mac.
# Старое имя terminalus рядом зовёт эту обёртку: его помнят агенты в разговорах, начатых до переименования.
# Запускает lib/kermach.js программой из KERMACH_NODE (программа в режиме Node); её ставит терминал Kermach.
# TERMINALUS_NODE — та же переменная до t1307: она одна у вкладок демона, запущенного до переименования.
# Нет KERMACH_NODE (терминал не Kermach или открыт до обновления) — node из PATH, объяснит сам скрипт; нет и node — код 2.
dir=$(dirname "$0")
[ -z "$KERMACH_NODE" ] && KERMACH_NODE=$TERMINALUS_NODE
if [ -z "$KERMACH_NODE" ]; then
  command -v node >/dev/null 2>&1 || { echo 'kermach: команда работает только в терминале Kermach. Этот терминал открыт не в Kermach или до обновления — откройте новую вкладку.' >&2; exit 2; }
  exec node "$dir/lib/kermach.js" "$@"
fi
ELECTRON_RUN_AS_NODE=1 exec "$KERMACH_NODE" "$dir/lib/kermach.js" "$@"
